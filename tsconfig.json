{
  // Node 侧代码：lib 里不放 DOM。面板源码与面板测试在 tsconfig.web.json 里检查；
  // 本地测试入口（会把面板测试打进来）在 tsconfig.scripts.json 里检查。
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "scripts",
    "src/webui",
    "tests/webui.test.ts",
    "tests/helpers/mock-panel-host.ts"
  ]
}
